{
  "name": "frontend",
  "version": "3.0.0",
  "description": "NoFluxo UNB - Frontend Application built with SvelteKit",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-pdf-worker.cjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run src/lib/stores/a11y.test.ts src/lib/components/a11y",
    "test:e2e:a11y": "playwright test tests-e2e/a11y.spec.ts"
  },
  "keywords": [
    "sveltekit",
    "svelte",
    "nofluxo",
    "unb",
    "fluxograma"
  ],
  "author": "NoFluxo Team",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@internationalized/date": "^3.11.0",
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.52.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.24",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^17.3.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.51.2",
    "svelte-check": "^4.4.0",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "@xyflow/svelte": "^1.6.1",
    "bits-ui": "^2.15.5",
    "clsx": "^2.1.1",
    "html2canvas-pro": "^2.0.2",
    "lucide-svelte": "^0.564.0",
    "pdfjs-dist": "^5.4.624",
    "svelte-sonner": "^1.0.7",
    "tailwind-merge": "^3.4.1",
    "tailwind-variants": "^3.2.2",
    "zod": "^4.3.6"
  }
}
