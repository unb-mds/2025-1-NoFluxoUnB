/package-lock.json
# Cobertura / artefatos de teste Python
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage/
.pytest_cache/

# Material de estudo da disciplina de testes (mantido local, não versionado)
docs_testes/

# Relatórios LaTeX da disciplina de testes (entregáveis avulsos) e artefatos
# de compilação. As docs .md de docs/testes continuam versionadas (site mkdocs).
docs/testes/*.tex
docs/testes/*.pdf
docs/testes/*.aux
docs/testes/*.log
docs/testes/*.out
docs/testes/*.toc

# Fixtures grandes do teste exploratório (geradas por make-fixtures.sh).
# Os PDFs pequenos ficam versionados; os de 10 MB são reconstruídos sob demanda.
docs/testes/fixtures/size_10mb_exact.pdf
docs/testes/fixtures/size_10mb_plus1.pdf

# Dumps de sessão do Playwright MCP (console/page com timestamp).
.playwright-mcp/

# CSV bruto de avaliações de disciplinas: tem nome de professor e comentários
# de aluno sem redação — nunca deve entrar no histórico do git. O import lê
# direto deste diretório local (fonte de verdade fica no Google Forms/Drive).
opinioes_publicas/

# Relatórios do import de avaliações (scripts/import_avaliacoes_disciplinas.ts):
# incluem trechos de texto livre para revisão manual, mesmo já redigidos.
backend/scripts/_import_reports/
linhas_avaliacoes_nao_importadas.json

# Backups de .env: o padrão `.env` acima não cobre sufixos, e um `.env.bak`
# carrega a chave viva tanto quanto o original.
.env.bak*
*.env.bak*

# Investigação de dados pré-ML: scripts de análise pontual (somente leitura,
# via service role) e a saída bruta deles — agregados por id_user com
# classificação de ruído e scores. Nada disso é código de produção; o que
# interessa é o relatório consolidado em docs/investigacoes/.
# Os .mjs ficam no disco pra poder reexecutar a medição (ex.: conferir se a
# cobertura de turmas_historico melhorou), mas não entram no repositório.
scripts/investigacao_ml/

# Saída de revisão do atualizar_departamentos_id.py: o script gera esse arquivo
# pra conferir o diff antes de aplicar. A lista que os scrapers leem é a
# departamentos_ID_unb.csv, que continua versionada.
DBA/scraping/departamentos_ID_unb_novo.csv

# Setup de Docker para dev local (conveniência individual, não versionado).
dev.backend.Dockerfile
dev.frontend-svelte.Dockerfile
dev.mcp-agent.Dockerfile
docker-compose.yml

# Workspace de execução do subagent-driven-development (ledger, briefs, review packages).
.superpowers/

# Worktrees isolados criados pelo harness para agents paralelos (isolation: "worktree").
.claude/worktrees/

# Material confidencial de negócio (precificação, pitches) — não versionar.
documentacao/modelo_de_negocio_precificacao.*
documentacao/pitch_vendas_investidor.*

# Configuração local de agents (uso individual, não versionado).
.agents/
