{
  "name": "nofluxo-unb",
  "version": "3.0.0",
  "description": "NoFluxo UNB - Sistema de fluxogramas acadêmicos",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "setup": "python scripts/setup_env.py --node",
    "setup:python": "python scripts/setup_env.py",
    "setup:node": "pnpm install",
    "dev": "pnpm --filter frontend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm run build:frontend && pnpm run build:backend",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "preview": "pnpm --filter frontend preview",
    "start:backend": "pnpm --filter backend start",
    "test": "pnpm run test:frontend && pnpm run test:backend",
    "test:frontend": "pnpm --filter frontend test:unit",
    "test:backend": "pnpm --filter backend test",
    "lint": "pnpm run lint:frontend && pnpm run lint:backend",
    "lint:frontend": "pnpm --filter frontend lint",
    "lint:backend": "pnpm --filter backend lint",
    "kb:query": "node scripts/docs-kb/kb.mjs query",
    "kb:graph": "node scripts/docs-kb/kb.mjs graph",
    "kb:drift": "node scripts/docs-kb/kb.mjs drift",
    "kb:snapshot": "node scripts/docs-kb/kb.mjs snapshot",
    "kb:check": "node scripts/docs-kb/kb.mjs check && node --test scripts/docs-kb/*.test.mjs"
  },
  "keywords": [
    "nofluxo",
    "unb",
    "fluxograma",
    "academico"
  ],
  "author": "NoFluxo Team",
  "license": "GPL-3.0-only",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unb-mds/2025-1-NoFluxoUNB.git"
  },
  "bugs": {
    "url": "https://github.com/unb-mds/2025-1-NoFluxoUNB/issues"
  },
  "homepage": "https://github.com/unb-mds/2025-1-NoFluxoUNB#readme"
}
