{
  "name": "backend",
  "version": "3.0.0",
  "description": "Backend do projeto No Fluxo com TypeScript, Express.js e Supabase",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build-and-start": "npm run build && npm run start",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "dev:full": "bash scripts/dev-full.sh",
    "install:all": "node scripts/install-all.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:session-persistence": "jest tests-ts/session-persistence.test.ts",
    "test:orquestrador-fase2": "jest tests-ts/orquestrador-fase2.test.ts",
    "test:revisor-fase3": "jest tests-ts/revisor-fase3.test.ts",
    "test:orquestrador": "jest tests-ts/session-persistence.test.ts tests-ts/orquestrador-fase2.test.ts tests-ts/revisor-fase3.test.ts",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.ts' 'tests-ts/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests-ts/**/*.ts' --fix",
    "type-check": "tsc --noEmit",
    "export-schema": "tsx scripts/export_schema.ts"
  },
  "keywords": [
    "typescript",
    "express",
    "supabase",
    "backend",
    "api"
  ],
  "author": "Squad 03",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@openai/agents": "^0.13.5",
    "@supabase/supabase-js": "^2.38.4",
    "axios": "^1.10.0",
    "body-parser": "^2.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "form-data": "^4.0.3",
    "helmet": "^7.1.0",
    "openai": "^6.48.0",
    "winston": "^3.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^30.5.2",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests-ts/**/*.test.ts",
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
