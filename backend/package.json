{
  "name": "backend",
  "version": "3.0.0",
  "description": "Backend do projeto No Fluxo com TypeScript, Express.js e Supabase",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build-and-start": "npm run build && npm run start",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "dev:full": "bash scripts/dev-full.sh",
    "install:all": "node scripts/install-all.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:session-persistence": "jest tests-ts/session-persistence.test.ts",
    "test:orquestrador-fase2": "jest tests-ts/orquestrador-fase2.test.ts",
    "test:revisor-fase3": "jest tests-ts/revisor-fase3.test.ts",
    "test:orquestrador": "jest tests-ts/session-persistence.test.ts tests-ts/orquestrador-fase2.test.ts tests-ts/revisor-fase3.test.ts",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts tests-ts/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests-ts/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "export-schema": "tsx scripts/export_schema.ts"
  },
  "keywords": [
    "typescript",
    "express",
    "supabase",
    "backend",
    "api"
  ],
  "author": "Squad 03",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@openai/agents": "^0.13.5",
    "@supabase/supabase-js": "^2.116.0",
    "axios": "^1.20.0",
    "body-parser": "^1.20.8",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "form-data": "^4.0.6",
    "helmet": "^7.2.0",
    "openai": "^6.49.0",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/form-data": "^2.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests-ts/**/*.test.ts",
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
