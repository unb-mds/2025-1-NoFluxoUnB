# NoFluxoUNB backend — local setup template
# Copy to .env only for initial setup; keep .env and real credentials out of Git.

# Supabase: privileged backend client (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Extra CORS origins, comma-separated. Adds to src/config/cors.ts defaults.
# ALLOWED_ORIGINS=https://preview.example.com

# IA configuration: fill only for providers used in your local setup.
MARITACA_API_KEY=
GOOGLE_API_KEY=
# Local scripts/dev-full.sh starts uvicorn on port 8000.
SABIA_API_URL=http://localhost:8000
# Shared backend/Python API credential, configured on both services.
MCP_AGENT_API_KEY=

# Development impersonation requires explicit opt-in; never enable in production.
ALLOW_DEV_IMPERSONATE=false

# Darcy questions: default per-user daily quota and global cost threshold (R$).
# Global cost check uses a cache and does not cover every IA path; see backend KB.
AI_COTA_DIARIA=30
AI_TETO_DIARIO_RS=15

# Optional RAGFlow integration
RAGFLOW_API_KEY=
RAGFLOW_BASE_URL=
RAGFLOW_AGENT_ID=

# Local Node runtime. Production environment is configured by deployment.
NODE_ENV=development
PORT=3325

# Rate-limit defaults; adjust only for your actual proxy topology and traffic.
# TRUST_PROXY=1
# RATE_LIMIT_GLOBAL_PER_MIN=120
# RATE_LIMIT_IA_PER_MIN=20
