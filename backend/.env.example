# NoFluxo Backend Docker Environment Configuration
# Copy this to .env and fill in your actual values

# === SUPABASE CONFIGURATION ===
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# === CORS ===
# Origens EXTRAS liberadas, separadas por vírgula (preview, staging...).
# Os domínios de produção já vêm fixos em src/config/cors.ts — esta variável
# só acrescenta, nunca substitui.
# ALLOWED_ORIGINS=https://preview.no-fluxo.com,https://staging.crianex.com

# === AI AGENT CONFIGURATION ===
# URL do mcp_agent (api_producao.py) e API key compartilhada com ele.
# Gere com: openssl rand -hex 32 — o mesmo valor vai na env MCP_AGENT_API_KEY do mcp_agent.
SABIA_API_URL=http://localhost:8000
MCP_AGENT_API_KEY=your_shared_mcp_agent_api_key_here
# Habilita o bypass X-Dev-Impersonate (somente dev; NUNCA setar em produção)
ALLOW_DEV_IMPERSONATE=false
# Darcy: perguntas por aluno por dia (renova à meia-noite de Brasília) e teto
# global de custo de IA no dia, em R$ (acima disso o assistente pausa até amanhã).
AI_COTA_DIARIA=30
AI_TETO_DIARIO_RS=15
RAGFLOW_API_KEY=your_ragflow_api_key_here
RAGFLOW_BASE_URL=your_ragflow_base_url_here
RAGFLOW_AGENT_ID=your_ragflow_agent_id_here

# === DOCKER AUTO-UPDATE CONFIGURATION ===
# Git credentials for auto-updating the repository in Docker
GIT_USERNAME=your_github_username
GIT_TOKEN=your_github_personal_access_token

# Branch to monitor for updates (default: main)
GIT_BRANCH=main

# Fork repository URL for automatic cloning (optional)
# If specified, the fork will be cloned inside the container and updated automatically
# Example: https://github.com/yourusername/2025-1-NoFluxoUNB.git
FORK_URL=

# === NODE.JS CONFIGURATION ===
NODE_ENV=production
PORT=3325

# === AI AGENT PORT ===
AI_AGENT_PORT=4652

# === PDF PARSER CONFIGURATION ===

# === LOGGING CONFIGURATION ===
LOG_LEVEL=info 